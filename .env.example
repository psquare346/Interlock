# Copy to backend/.env — every key documented in files/START-HERE.md.
# Everything is optional: with this file untouched the platform runs in
# local mode (SQLite, rule-based ingestion, dev crypto).

# --- §2 Database ---
DATABASE_URL=sqlite:///./punchout.db
PGVECTOR_ENABLED=false

# --- §1 AI provider ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RERANK_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_SMART=
EMBEDDING_MODEL=
LLM_BATCH_MODE=true
LLM_MAX_SPEND_USD_PER_JOB=10

# --- §3 SAP S/4HANA ---
SAP_SYSTEM_ID=
SAP_CLIENT=
SAP_FIORI_BASE_URL=
SAP_OCI_VERSION=4.0
SAP_COMPANY_CODE=
SAP_PURCH_ORG=
SAP_PLANT=
SAP_CURRENCY=USD

# --- §6 Secrets ---
SECRET_BACKEND=env
ENCRYPTION_KEY=
